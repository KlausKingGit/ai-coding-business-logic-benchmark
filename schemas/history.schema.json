{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Run History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "task_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^task_\\d{2}_[a-z0-9_]+$"}
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "candidate", "environment", "summary"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "candidate": {"type": "object"},
          "environment": {"type": "object"},
          "summary": {"type": "object"}
        }
      }
    }
  }
}
