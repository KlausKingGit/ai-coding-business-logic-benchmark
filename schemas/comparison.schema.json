{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Result Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "baseline", "candidate", "delta", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "passed", "failed", "errors"],
      "properties": {
        "score": {"type": "integer"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "errors": {"type": "integer"}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "baseline_score", "candidate_score", "score_delta"],
        "properties": {
          "id": {"type": "string", "pattern": "^task_\\d{2}_[a-z0-9_]+$"},
          "baseline_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "candidate_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "score_delta": {"type": "integer"}
        }
      }
    }
  }
}
