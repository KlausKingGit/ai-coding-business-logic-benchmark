{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Business-Logic Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "benchmark_version", "description", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "benchmark_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^task_\\d{2}_[a-z0-9_]+$"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
