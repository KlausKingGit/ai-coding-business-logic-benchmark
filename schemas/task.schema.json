{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Business-Logic Task Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "summary", "area", "tags", "candidates", "tests", "review_notes", "expected", "known_limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^task_\\d{2}_[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "area": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "flawed"],
      "properties": {
        "reference": {"const": "reference_solution.py"},
        "flawed": {"const": "flawed_candidate.py"}
      }
    },
    "tests": {"const": "tests/test_cases.py"},
    "review_notes": {"const": "evaluation_notes.md"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "flawed"],
      "properties": {
        "reference": {"const": "pass_all"},
        "flawed": {"const": "fail_at_least_one"}
      }
    },
    "known_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
